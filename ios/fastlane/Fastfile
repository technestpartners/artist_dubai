default_platform(:ios)

platform :ios do
  before_all do
    # Ensure App Store Connect API Key is configured if provided in ENV
    if ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"] && ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"]
      key_content = ENV["APP_STORE_CONNECT_API_KEY_KEY"]
      if key_content.nil? && ENV["APP_STORE_CONNECT_API_KEY_KEY_BASE64"]
        require "base64"
        key_content = Base64.decode64(ENV["APP_STORE_CONNECT_API_KEY_KEY_BASE64"])
      end

      if key_content
        app_store_connect_api_key(
          key_id: ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"],
          issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
          key_content: key_content,
          is_key_content_base64: false,
          in_house: false
        )
      elsif ENV["APP_STORE_CONNECT_API_KEY_PATH"]
        app_store_connect_api_key(
          key_id: ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"],
          issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
          key_filepath: ENV["APP_STORE_CONNECT_API_KEY_PATH"],
          in_house: false
        )
      end
    end
  end

  desc "Build Flutter iOS and upload to TestFlight"
  lane :beta do |options|
    ipa_path = options[:ipa_path] || Dir["../build/ios/ipa/*.ipa"].first

    unless ipa_path && File.exist?(ipa_path)
      UI.message("Building Flutter iOS IPA...")
      sh("cd ../.. && flutter build ipa --release --export-options-plist=ios/ExportOptions.plist")
      ipa_path = Dir["../build/ios/ipa/*.ipa"].first
    end

    UI.user_error!("IPA not found at #{ipa_path}") unless ipa_path && File.exist?(ipa_path)

    UI.message("Uploading #{ipa_path} to TestFlight...")
    upload_to_testflight(
      ipa: ipa_path,
      skip_waiting_for_build_processing: options[:skip_waiting] || false,
      changelog: options[:changelog] || "Bug fixes and stability improvements",
      distribute_external: options[:distribute_external] || false
    )
  end

  desc "Build Flutter iOS and upload/publish directly to the App Store for Production Review"
  lane :release do |options|
    ipa_path = options[:ipa_path] || Dir["../build/ios/ipa/*.ipa"].first

    unless ipa_path && File.exist?(ipa_path)
      UI.message("Building Flutter iOS IPA for App Store...")
      sh("cd ../.. && flutter build ipa --release --export-options-plist=ios/ExportOptions.plist")
      ipa_path = Dir["../build/ios/ipa/*.ipa"].first
    end

    UI.user_error!("IPA not found at #{ipa_path}") unless ipa_path && File.exist?(ipa_path)

    submit_review = options[:submit_for_review].nil? ? true : options[:submit_for_review]
    auto_release = options[:automatic_release].nil? ? true : options[:automatic_release]
    phased = options[:phased_release].nil? ? false : options[:phased_release]

    UI.message("Uploading to App Store Connect and preparing submission...")
    upload_to_app_store(
      ipa: ipa_path,
      force: true,
      skip_screenshots: true,
      skip_metadata: options[:skip_metadata].nil? ? true : options[:skip_metadata],
      submit_for_review: submit_review,
      automatic_release: auto_release,
      phased_release: phased,
      reject_if_possible: options[:reject_if_possible] || false
    )
  end

  desc "Promote an existing TestFlight build to App Store for Production Review without rebuilding"
  lane :promote_to_app_store do |options|
    app_version = options[:app_version]
    build_number = options[:build_number]

    upload_to_app_store(
      app_version: app_version,
      build_number: build_number,
      force: true,
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: true,
      submit_for_review: options[:submit_for_review].nil? ? true : options[:submit_for_review],
      automatic_release: options[:automatic_release].nil? ? true : options[:automatic_release],
      phased_release: options[:phased_release].nil? ? false : options[:phased_release]
    )
  end
end
