default_platform(:ios)

platform :ios do
  before_all do
    # Ensure App Store Connect API Key is configured if provided in ENV
    if ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"] && ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"]
      key_content = ENV["APP_STORE_CONNECT_API_KEY_KEY"]
      if key_content.nil? && ENV["APP_STORE_CONNECT_API_KEY_KEY_BASE64"]
        require "base64"
        key_content = Base64.decode64(ENV["APP_STORE_CONNECT_API_KEY_KEY_BASE64"])
      end

      if key_content
        app_store_connect_api_key(
          key_id: ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"],
          issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
          key_content: key_content,
          is_key_content_base64: false,
          in_house: false
        )
      elsif ENV["APP_STORE_CONNECT_API_KEY_PATH"]
        app_store_connect_api_key(
          key_id: ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"],
          issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
          key_filepath: ENV["APP_STORE_CONNECT_API_KEY_PATH"],
          in_house: false
        )
      end
    end
  end

  desc "Build Flutter iOS and upload to TestFlight"
  lane :beta do |options|
    # Locate IPA or build it if not already built
    ipa_path = options[:ipa_path] || Dir["../build/ios/ipa/*.ipa"].first

    unless ipa_path && File.exist?(ipa_path)
      UI.message("Building Flutter iOS IPA...")
      # Run flutter build from root directory
      sh("cd ../.. && flutter build ipa --release --export-options-plist=ios/ExportOptions.plist")
      ipa_path = Dir["../build/ios/ipa/*.ipa"].first
    end

    UI.user_error!("IPA not found at #{ipa_path}") unless ipa_path && File.exist?(ipa_path)

    UI.message("Uploading #{ipa_path} to TestFlight...")
    upload_to_testflight(
      ipa: ipa_path,
      skip_waiting_for_build_processing: options[:skip_waiting] || false,
      changelog: options[:changelog] || "Bug fixes and stability improvements",
      distribute_external: options[:distribute_external] || false
    )
  end

  desc "Upload existing IPA directly to TestFlight"
  lane :upload_ipa do |options|
    ipa_path = options[:ipa_path] || Dir["../build/ios/ipa/*.ipa"].first
    UI.user_error!("Please provide an ipa_path or ensure IPA exists in build/ios/ipa/") unless ipa_path && File.exist?(ipa_path)

    upload_to_testflight(
      ipa: ipa_path,
      skip_waiting_for_build_processing: options[:skip_waiting] || false,
      changelog: options[:changelog] || "New build uploaded via Fastlane"
    )
  end

  desc "Build and submit to App Store Connect for Production review"
  lane :release do |options|
    ipa_path = options[:ipa_path] || Dir["../build/ios/ipa/*.ipa"].first

    unless ipa_path && File.exist?(ipa_path)
      sh("cd ../.. && flutter build ipa --release --export-options-plist=ios/ExportOptions.plist")
      ipa_path = Dir["../build/ios/ipa/*.ipa"].first
    end

    UI.user_error!("IPA not found at #{ipa_path}") unless ipa_path && File.exist?(ipa_path)

    upload_to_app_store(
      ipa: ipa_path,
      force: true,
      skip_screenshots: true,
      skip_metadata: options[:skip_metadata] || true
    )
  end
end
