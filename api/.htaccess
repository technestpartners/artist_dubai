# Artist Dubai API - Hardened Production Security Configuration
ServerSignature Off

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block TRACE / TRACK / CONNECT method attempts early
    RewriteCond %{REQUEST_METHOD} ^(TRACE|TRACK|CONNECT) [NC]
    RewriteRule .* - [F]

    RewriteRule ^api\.php$ api.php [QSA,L]
    RewriteRule ^$ api.php [QSA,L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ api.php [QSA,L]
</IfModule>

# Block access to database dumps, configuration files, environment variables and sensitive files
<FilesMatch "(?i)\.(sql|sqlite|sqlite3|db|env|git|gitignore|yml|yaml|bak|backup|log|conf|ini|lock|zip|tar|gz|sh|bash|ps1|bat|cmd|phar|phtml|phps|php3|php4|php5|php7|php8|json|md|pem|key|crt|cert|svg)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Prohibit access to hidden / dot files
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Security Headers & Content Protection
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "DENY"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    Header set Content-Security-Policy "default-src 'none'; frame-ancestors 'none';"
    Header unset X-Powered-By
</IfModule>

# Safe static image caching & cross-origin access (Strictly raster/web formats, SVG excluded to eliminate stored XSS)
<FilesMatch "\.(jpg|jpeg|png|gif|webp|ico)$">
    <IfModule mod_headers.c>
        Header set Access-Control-Allow-Origin "*"
        Header set Access-Control-Allow-Methods "GET, OPTIONS"
        Header set Access-Control-Allow-Headers "*"
        Header set Cross-Origin-Resource-Policy "cross-origin"
        Header set Timing-Allow-Origin "*"
        Header set X-Content-Type-Options "nosniff"
        Header set Cache-Control "public, max-age=604800, immutable"
        Header unset Content-Security-Policy
    </IfModule>
</FilesMatch>

Options -Indexes -ExecCGI
