# Exclude API and existing files from build/web redirect
<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Do not rewrite api.php or api/
    RewriteRule ^api\.php - [L]
    RewriteRule ^api/ - [L]

    # Don't rewrite if the requested file or directory exists
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    RewriteCond %{REQUEST_URI} !build/web/
    RewriteRule ^(.*)$ build/web/$1 [L]
</IfModule>

DirectoryIndex build/web/index.html index.html index.php
